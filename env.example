# Arix configuration — copy to `.env` and fill in.
#
#   cp env.example .env
#
# Minimal setup: only the values in section 1 are required. Everything else
# (LLM provider, WooCommerce credentials, business profile) is configured from
# the dashboard's first-run setup wizard at http://localhost:3000 and stored
# encrypted in Postgres. Env values below act as SEEDS/overrides: while set,
# they win over dashboard values and show as read-only in the UI.

# ──────────────────────────────────────────────────────────────────────────────
# 1. Required
# ──────────────────────────────────────────────────────────────────────────────

# Session signing secret. Long and random, min 16 chars:
#   openssl rand -hex 32
# Rotating it logs everyone out, but does not affect encrypted settings when
# SETTINGS_ENCRYPTION_KEY is configured separately as recommended below.
AUTH_JWT_SECRET=

# One-shot credential required to create the first administrator (min 32
# chars). Generate it independently, then paste it into the setup wizard:
#   openssl rand -hex 32
# It is never injected into the dashboard container and is not stored there.
# Keep it secret even after bootstrap; the endpoint is also permanently
# disabled as soon as the first staff account exists.
SETUP_TOKEN=

# Strongly recommended for every new/production deployment: an INDEPENDENT
# settings-encryption key (min 32 chars). Generate a different value from the
# JWT secret. Existing installs may leave this unset temporarily; Arix then
# reads legacy secrets using AUTH_JWT_SECRET for backward compatibility.
# SETTINGS_ENCRYPTION_KEY=
# During rotation only, put the old key(s) here, comma-separated, start Arix so
# stored secrets are re-encrypted with the active key, then remove this value.
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Docker Compose: the database container + server connection are built from these.
POSTGRES_USER=arix
POSTGRES_PASSWORD=
POSTGRES_DB=arix

# Local development WITHOUT Docker: point the server at your own Postgres
# (Compose sets this automatically for the internal network — leave it unset there).
# DATABASE_URL=postgres://arix:arix@localhost:5432/arix

# ──────────────────────────────────────────────────────────────────────────────
# 2. Optional seeds — the setup wizard covers all of these
# ──────────────────────────────────────────────────────────────────────────────

# LLM_PROVIDER=openai            # openai | anthropic | gemini | deepseek | minimax
# LLM_API_KEY=
# LLM_MODEL=                     # empty = provider default
# LLM_BASE_URL=                  # empty = provider default (set for proxies/self-hosted)
# LLM_REASONING_SPLIT=false      # MiniMax only
# LLM_THINKING_DISABLED=false    # MiniMax only

# WC_URL=https://your-store.com  # WordPress/WooCommerce REST domain
# WC_CONSUMER_KEY=               # WooCommerce → Settings → Advanced → REST API (Read/Write)
# WC_CONSUMER_SECRET=
# WC_FRONT_URL=                  # headless storefront URL, if different from WC_URL
# WC_CURRENCY=USD
# WC_STATUS_AFTER_PAYMENT=processing
# WC_STATUS_AFTER_DISPATCH=      # custom status set on dispatch (must exist in Woo)
# PAYMENT_AMOUNT_TOLERANCE=1
# PAYMENT_AUTO_CONFIRM=false     # keep false unless payment is independently reconciled

# BUSINESS_NAME=My Store
# BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
# AGENT_NAME=Arix
# AGENT_LANGUAGE=es              # es | en
# AGENT_DISCLOSE_BOT=false       # true = agent presents itself as an AI assistant

# SKILLS_ENABLED=catalog,orders,payments,handoff   # CSV or JSON array of skill ids
# MCP_SERVERS=[]                   # JSON: HTTPS Streamable HTTP servers + allowedTools
# Optional exact-host allowlist (comma-separated). Public HTTPS + SSRF checks
# always apply; set this for stricter production egress control.
# MCP_ALLOWED_HOSTS=mcp.example.com,api.vendor.com

# ──────────────────────────────────────────────────────────────────────────────
# 3. Infra (defaults are fine for most deployments)
# ──────────────────────────────────────────────────────────────────────────────

# PORT=3001                      # server API port (not exposed to the host in Docker)
# TRUST_PROXY=false              # trust exactly one proxy hop for client IPs
# PG_CONNECT_TIMEOUT_MS=10000     # fail fast if PostgreSQL cannot be reached
# PG_STATEMENT_TIMEOUT_MS=30000   # cancel individual SQL statements that wedge
# PG_IDLE_TIMEOUT_MS=30000        # release idle pool connections
# SHUTDOWN_TIMEOUT_MS=15000       # hard deadline for graceful process shutdown
# RECEIPTS_DIR=./data/receipts   # receipt image storage (a volume in Docker)
# MAX_MEDIA_BYTES=10485760       # max downloaded image/document size (10 MiB)
# MEDIA_DOWNLOAD_TIMEOUT_MS=30000 # abort slow WhatsApp media downloads
# MAX_IMAGE_PIXELS=25000000      # decoded receipt pixel ceiling
# MAX_IMAGE_DIMENSION=12000      # decoded width/height ceiling
# MAX_PDF_BYTES=10485760         # max PDF receipt size before rasterization
# PDF_TIMEOUT_MS=15000           # hard timeout for pdftoppm
# RECEIPT_RETENTION_DAYS=90      # delete expired receipt files; <=0 disables cleanup
# ALLOW_PRIVATE_NETWORKS=false   # opt in only for a trusted LAN WooCommerce host
# ALLOW_INSECURE_HTTP=false      # opt in only when HTTPS is impossible on that trusted host
# LOG_LEVEL=info
# COOKIE_SECURE=false            # set true when serving the dashboard over HTTPS
# WA_ACCOUNT_ID=default          # namespaces the WhatsApp session in Postgres
# WA_MARK_ONLINE=false
# WA_QR_TERMINAL=false           # QR is credential-like; prefer the authenticated dashboard
# AGENT_HISTORY_LIMIT=30         # messages of context per reply
# AGENT_DEBOUNCE_MS=60000        # wait after the last message before replying
# AGENT_MAX_BUBBLES=3            # max WhatsApp bubbles per reply
# AGENT_TURN_TIMEOUT_MS=90000     # total budget across LLM retries and tools
# AGENT_RECOVERY_CONCURRENCY=3    # bounded unanswered/outbox recovery workers
# AGENT_RECOVERY_BATCH_SIZE=50    # max conversations attempted per recovery cycle
# OUTBOX_RECOVERY_INTERVAL_MS=30000 # periodic durable recovery scan

# Dashboard-only (local dev without Docker; Compose sets it internally):
# SERVER_API_URL=http://localhost:3001
