# Arix configuration — copy to `.env` and fill in.
#
#   cp env.example .env
#
# Minimal setup: only the values in section 1 are required. Everything else
# (LLM provider, WooCommerce credentials, business profile) is configured from
# the dashboard's first-run setup wizard at http://localhost:3000 and stored
# encrypted in Postgres. Env values below act as SEEDS/overrides: while set,
# they win over dashboard values and show as read-only in the UI.

# ──────────────────────────────────────────────────────────────────────────────
# 1. Required
# ──────────────────────────────────────────────────────────────────────────────

# Session signing + settings encryption root. Long and random, min 16 chars:
#   openssl rand -hex 32
# Rotating it logs everyone out and invalidates dashboard-stored secrets.
AUTH_JWT_SECRET=

# Docker Compose: the database container + server connection are built from these.
POSTGRES_USER=arix
POSTGRES_PASSWORD=
POSTGRES_DB=arix

# Local development WITHOUT Docker: point the server at your own Postgres
# (Compose sets this automatically for the internal network — leave it unset there).
# DATABASE_URL=postgres://arix:arix@localhost:5432/arix

# ──────────────────────────────────────────────────────────────────────────────
# 2. Optional seeds — the setup wizard covers all of these
# ──────────────────────────────────────────────────────────────────────────────

# LLM_PROVIDER=openai            # openai | anthropic | gemini | deepseek | minimax
# LLM_API_KEY=
# LLM_MODEL=                     # empty = provider default
# LLM_BASE_URL=                  # empty = provider default (set for proxies/self-hosted)
# LLM_REASONING_SPLIT=false      # MiniMax only
# LLM_THINKING_DISABLED=false    # MiniMax only

# WC_URL=https://your-store.com  # WordPress/WooCommerce REST domain
# WC_CONSUMER_KEY=               # WooCommerce → Settings → Advanced → REST API (Read/Write)
# WC_CONSUMER_SECRET=
# WC_FRONT_URL=                  # headless storefront URL, if different from WC_URL
# WC_CURRENCY=USD
# WC_STATUS_AFTER_PAYMENT=processing
# WC_STATUS_AFTER_DISPATCH=      # custom status set on dispatch (must exist in Woo)
# PAYMENT_AMOUNT_TOLERANCE=1

# BUSINESS_NAME=My Store
# BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
# AGENT_NAME=Arix
# AGENT_LANGUAGE=es              # es | en
# AGENT_DISCLOSE_BOT=false       # true = agent presents itself as an AI assistant

# SKILLS_ENABLED=catalog,orders,payments,handoff   # CSV or JSON array of skill ids
# MCP_SERVERS=[]                   # JSON: HTTPS Streamable HTTP servers + allowedTools
# Optional exact-host allowlist (comma-separated). Public HTTPS + SSRF checks
# always apply; set this for stricter production egress control.
# MCP_ALLOWED_HOSTS=mcp.example.com,api.vendor.com

# ──────────────────────────────────────────────────────────────────────────────
# 3. Infra (defaults are fine for most deployments)
# ──────────────────────────────────────────────────────────────────────────────

# PORT=3001                      # server API port (not exposed to the host in Docker)
# RECEIPTS_DIR=./data/receipts   # receipt image storage (a volume in Docker)
# LOG_LEVEL=info
# COOKIE_SECURE=false            # set true when serving the dashboard over HTTPS
# WA_ACCOUNT_ID=default          # namespaces the WhatsApp session in Postgres
# WA_MARK_ONLINE=false
# AGENT_HISTORY_LIMIT=30         # messages of context per reply
# AGENT_DEBOUNCE_MS=60000        # wait after the last message before replying
# AGENT_MAX_BUBBLES=3            # max WhatsApp bubbles per reply

# Dashboard-only (local dev without Docker; Compose sets it internally):
# SERVER_API_URL=http://localhost:3001
