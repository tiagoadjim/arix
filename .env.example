# =============================================================================
# Nico — Vapenic WhatsApp AI agent — environment variables
# Copy to .env and fill in. NEVER commit .env.
# Fully self-hosted: Postgres + receipt files live on your VPS (no Supabase).
# =============================================================================

# ---- Minimax (LLM) ----------------------------------------------------------
# OpenAI-compatible endpoint. Subscription: https://platform.minimax.io
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Model that supports vision (read receipts) + tool calling.
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MODEL_FAST=MiniMax-M3
# M3 is a thinking model. With reasoning_split=true its thinking is returned in
# separate fields instead of inline <think>. OPT-IN, leave OFF: M3's tool-calling
# degrades in that mode unless reasoning_details is round-tripped in the history
# every turn (Nico stores plain text only). Off = inline <think>, stripped before
# the reply. (true/false)
MINIMAX_REASONING_SPLIT=false
# Optional hard-off switch: disable thinking entirely on M3 (faster, zero leak,
# slightly lower quality on tools/payments). (true/false)
MINIMAX_THINKING_DISABLED=false

# ---- WooCommerce (store, headless) ------------------------------------------
# WC_URL = dominio de WordPress / REST API. WC_FRONT_URL = storefront headless
# (de donde salen los links de producto que Nico comparte).
WC_URL=https://vapenic.com.ar
WC_FRONT_URL=https://shop.vapenic.com.ar
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_CURRENCY=ARS
PAYMENT_AMOUNT_TOLERANCE=1
WC_STATUS_AFTER_PAYMENT=processing
# Status applied when staff dispatches an order via Uber Moto from the dashboard.
# Must be a status registered in WooCommerce (a custom "en-camino" by default).
WC_STATUS_AFTER_DISPATCH=en-camino

# ---- Postgres (data) --------------------------------------------------------
# Used by the `db` container in docker-compose.
POSTGRES_USER=nico
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=nico
# Connection string the server uses. In Docker this is overridden to use host `db`.
# For local dev (Postgres on your machine) point it at localhost:
DATABASE_URL=postgres://nico:change-me-strong@localhost:5432/nico

# ---- Storage (receipt images) ----------------------------------------------
# Directory where receipt images are saved. In Docker this is a volume at
# /app/data/receipts (overridden by compose). For local dev a relative path is fine.
RECEIPTS_DIR=./data/receipts

# ---- Auth (dashboard staff login) ------------------------------------------
# Secret used to sign session JWTs. Use a long random string. MUST match between
# server and dashboard (the dashboard verifies the cookie).
AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Set to true when serving the dashboard over HTTPS (recommended in production).
COOKIE_SECURE=false

# ---- Server API -------------------------------------------------------------
PORT=3001

# ---- WhatsApp / Baileys -----------------------------------------------------
WA_ACCOUNT_ID=vapenic-main
WA_MARK_ONLINE=false

# ---- Nico behaviour ---------------------------------------------------------
NICO_NAME=Nico
NICO_BUSINESS=Vapenic
NICO_HISTORY_LIMIT=30
# Esperar este tiempo desde el último mensaje del cliente antes de responder
# (junta varios mensajes seguidos). Por defecto 60s.
NICO_DEBOUNCE_MS=60000
# Máximo de burbujas de WhatsApp por respuesta.
NICO_MAX_BUBBLES=3
LOG_LEVEL=info

# ---- Dashboard --------------------------------------------------------------
# Where the dashboard proxies /api/* . In Docker this is overridden to http://server:3001.
SERVER_API_URL=http://localhost:3001
# Must match AUTH_JWT_SECRET above (the dashboard verifies the session cookie).
# (The dashboard reads AUTH_JWT_SECRET directly; no separate var needed.)
